{
  "name": "controller-notify",
  "version": "1.0.1",
  "description": "A cute desktop companion that notifies you when your favorite YouTube streamer goes live",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder",
    "lint": "eslint src/",
    "test": "node --test tests/*.test.js"
  },
  "keywords": [
    "electron",
    "youtube",
    "live",
    "notifier",
    "tray"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "canvas": "^3.2.3",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "eslint": "^8.56.0",
    "sharp": "^0.35.3"
  },
  "dependencies": {
    "axios": "^1.6.2",
    "dotenv": "^17.4.2",
    "electron-store": "^8.1.0"
  },
  "build": {
    "appId": "com.controllernotify.app",
    "productName": "Controller Notify",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
